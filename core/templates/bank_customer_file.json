        {
          "name": "Application",
          "regex": "application\\s+form|loan\\s+application|account\\s+opening|application\\s+no",
          "zones": [
            {
              "name": "application_number",
              "regex": "(?i)Application\\s*(?:No|Number|#)\\.?\\s*[:.]?\\s*([A-Z0-9][A-Z0-9\\-/]{3,})"
            },
            {
              "name": "applicant_name",
              "regex": "(?i)(?:Applicant|Customer|Full)\\s*Name\\s*[:.]?\\s*([A-Za-z.]+(?: [A-Za-z.]+){0,4}?)(?=\\s+(?:Product|NIC|ID|Date|Address|Mobile|Tel|Branch|Requested|Amount)\\b|$)"
            },
            {
              "name": "product",
              "regex": "(?i)Product\\s*[:.]?\\s*([A-Za-z]+(?: [A-Za-z]+){0,3}?)(?=\\s+(?:Requested|Amount|Branch|Date|Tenure|Rate)\\b|$)"
            },
            {
              "name": "application_date",
              "regex": "(?i)Application\\s*Date\\s*[:.]?\\s*(\\d{1,2}[ ./-](?:[A-Za-z]{3,9}|\\d{1,2})[ ./-]\\d{2,4})"
            }
          ]
        },
        {
          "name": "NIC",
          "regex": "national\\s+identity\\s+card|identity\\s+card|ntity\\s+card|holder.?s\\s+signature",
          "zones": [
            {
              "name": "nic_number",
              "regex": "\\b(\\d{9}[VvXx]|\\d{12})\\b"
            },
            {
              "name": "nic_name",
              "regex": "(?i)Name\\s*[:.]?\\s*([A-Za-z.]+(?: [A-Za-z.]+){0,4}?)(?=\\s+(?:ID|NIC|Date|Address|Sex|Gender|Given)\\b|$)"
            },
            {
              "name": "nic_date_of_birth",
              "regex": "(?i)(?:Date\\s*of\\s*Birth|DOB)\\s*[:.]?\\s*(\\d{1,2}[ ./-](?:[A-Za-z]{3,9}|\\d{1,2})[ ./-]\\d{2,4})"
            }
          ]
        },
        {
          "name": "Letter",
          "regex": "to\\s+whom\\s+it\\s+may\\s+concern|dear\\s+(?:sir|madam)|confirmation\\s+of|subject\\s*:",
          "zones": [
            {
              "name": "letter_subject",
              "regex": "(?i)Subject\\s*:\\s*([^:]{3,80}?)(?=\\s+(?:Dear|To whom|Ref)\\b|$)"
            },
            {
              "name": "letter_reference",
              "regex": "(?i)(?:Our\\s*)?Ref(?:erence)?\\s*(?:No)?\\.?\\s*[:.]\\s*([A-Z0-9][A-Z0-9\\-/]{2,})"
            },
            {
              "name": "letter_date",
              "regex": "(?i)(?<!of )Date\\s*[:.]?\\s*(\\d{1,2}[ ./-](?:[A-Za-z]{3,9}|\\d{1,2})[ ./-]\\d{2,4})"
            }
          ]
        }
      ]
    },
