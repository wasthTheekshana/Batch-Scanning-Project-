# nginx in front of the central service when you do not use the Caddy proxy.
# Put in /etc/nginx/conf.d/dokscanner-central.conf, set the server name and the
# certificate paths (for example from Let's Encrypt / certbot).
server {
    listen 80;
    server_name central.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name central.example.com;

    ssl_certificate     /etc/letsencrypt/live/central.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/central.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # REQUIRED: the service's own 256 KB config cap applies only after the body
    # has been read, so the proxy must refuse large uploads itself.
    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    server_tokens off;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
