# The build context is the repository root, which holds gigabytes the service
# never needs (virtual environment, installers, test data). Send ONLY what the
# Dockerfile copies: central/ and the three core files it imports.
*
!central
!projects/__init__.py
!projects/profile_manager.py
!projects/project_schema.json

# ... and inside central/: no caches, no deployment files, no dashboard test output
**/__pycache__
**/*.pyc
central/deploy
