# Copy to .env (same folder) and fill in. Never commit the real .env.

# Public name of this server (what the PCs and admins type), e.g. central.example.com
CENTRAL_DOMAIN=central.example.com

# Database. Choose a long random password.
POSTGRES_USER=dokcentral
POSTGRES_DB=dokcentral
POSTGRES_PASSWORD=

# 32 or more random characters. Changing it signs every admin out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CENTRAL_SESSION_SECRET=

# The data key: encrypts what the server stores for you (the alert webhook address and, later,
# index data). Generate once:   docker compose run --rm central python -m central.manage generate-key
# KEEP A COPY APART FROM THE DATABASE BACKUPS. Without it that data cannot be read; with the
# database alone it cannot be read either. Leave empty to run without those features.
CENTRAL_DATA_KEY=

# 1 for the first start on an empty database (the tables are created then);
# raise afterwards (2 to 4 is plenty).
CENTRAL_WORKERS=1
